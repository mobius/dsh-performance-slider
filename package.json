{
  "name": "dsh-performance-slider",
  "version": "0.2.1",
  "description": "A 6-level Codex-style performance slider for the DeepSeek Harness web surface: each level maps a model + reasoning effort and switches through 31 local cutout background frames served by the plugin host.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.frames.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.frames.js",
    "cordis.patch.yml",
    "demo/pics/cutout",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mobius/dsh-performance-slider.git"
  },
  "homepage": "https://github.com/mobius/dsh-performance-slider#readme",
  "bugs": {
    "url": "https://github.com/mobius/dsh-performance-slider/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek",
    "dsh",
    "deepseek-harness",
    "cordis",
    "performance-slider",
    "reasoning-effort"
  ]
}
